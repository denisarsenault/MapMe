<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.mapme.app</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.mybrightzone.shared</string>
	</array>
	<!--
		HealthKit is requested ONLY so we can host an `HKWorkoutSession`
		around Live tracking. The session gives the watch app an
		effectively unlimited runtime budget for continuous CL
		streaming — `WKExtendedRuntimeSession` tops out around ~1-3
		hours and then the OS suspends us, which is what the user
		hit after a few hours of Start Live on. We do NOT read or
		write any health samples; nothing lands in the Health app.
	-->
	<key>com.apple.developer.healthkit</key>
	<true/>
</dict>
</plist>
