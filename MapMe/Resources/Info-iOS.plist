<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.mapme.daily-archive</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MapMe</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CKSharingSupported</key>
	<true/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSFaceIDUsageDescription</key>
	<string>MapMe uses Face ID as a faster way to enter your security code.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>MapMe needs background access to keep recording your location while the app is closed, so your daily history stays complete.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>MapMe records your location to map your real-time position and build a 24-hour history.</string>
	<key>NSMotionUsageDescription</key>
	<string>MapMe uses motion data to detect when you start moving so it can automatically resume tracking without you having to open the app.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<!--
			UIColorName / UIImageName reference asset-catalog entries.
			MMSplashBackground = dark navy colorset; MMLogo = frameless
			"MapMe" wordmark + pin (NOT the app icon). Both rendered by
			Tools/generate_icons.swift. UIImageRespectsSafeAreaInsets
			keeps the logo clear of the notch / Dynamic Island.
		-->
		<key>UIColorName</key>
		<string>MMSplashBackground</string>
		<key>UIImageName</key>
		<string>MMLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<!--
		Portrait-only on iPhone + iPad. Locking rotation lets the
		layouts (especially the dashboard chrome and the map +
		device-card stack) be tuned once for a known aspect ratio
		instead of needing landscape variants. Both arrays contain
		only `UIInterfaceOrientationPortrait`; the system blocks
		rotation to any other orientation.
	-->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
